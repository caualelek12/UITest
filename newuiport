                    AutoButtonColor=false, BorderSizePixel=0, Parent=row,
                })
                corner(kbBtn, UDim.new(0,3))
                onAC(function(c) if not listening then kbBtn.TextColor3=c end end)
                kbBtn.MouseButton1Click:Connect(function()
                    if listening then return end
                    listening=true; kbBtn.Text="..."; kbBtn.TextColor3=rgb(255,185,0)
                    kbBtn.BackgroundColor3=rgb(28,24,10)
                end)
